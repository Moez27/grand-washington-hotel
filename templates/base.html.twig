<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Séjours d'exception en Méditerranée{% endblock %} · {{ hotel_name }}</title>
    <meta name="description" content="{% block meta_description %}Symphonie Hotel & Spa, Hammamet : chambres et suites face à la mer, spa & hammam, réservation en ligne sécurisée.{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2216%22 fill=%22%23c8a165%22/><text x=%2232%22 y=%2244%22 font-size=%2234%22 text-anchor=%22middle%22 font-family=%22Georgia%22 fill=%22%230e1c2b%22>S</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    {% block stylesheets %}
        <link href="{{ asset('css/app.css') }}" rel="stylesheet">
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
{% block navbar %}
    {% set route = app.request.attributes.get('_route') %}
    <nav class="navbar navbar-expand-xl site-nav fixed-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <span class="brand-mark"><i class="bi bi-music-note-beamed"></i></span>
                <span>Symphonie<small>Hotel &amp; Spa</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto gap-lg-1">
                    <li class="nav-item"><a class="nav-link {{ route == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link {{ route starts with 'app_room' ? 'active' }}" href="{{ path('app_room_index') }}">Chambres &amp; Suites</a></li>
                    <li class="nav-item"><a class="nav-link {{ route == 'app_services' ? 'active' }}" href="{{ path('app_services') }}">Services &amp; Spa</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#contact">Contact</a></li>
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link cart-link {{ route starts with 'app_cart' ? 'active' }}" href="{{ path('app_cart') }}" aria-label="Panier">
                            <i class="bi bi-bag fs-5"></i>
                            {% if cart_count() > 0 %}<span class="cart-badge">{{ cart_count() }}</span>{% endif %}
                        </a>
                    </li>
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar">{{ app.user.initials }}</span>
                                <span class="d-xl-none d-xxl-inline">{{ app.user.firstName }}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item rounded-3" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-2 text-gold"></i>Administration</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                {% endif %}
                                <li><a class="dropdown-item rounded-3" href="{{ path('app_account') }}"><i class="bi bi-person me-2"></i>Mon compte</a></li>
                                <li><a class="dropdown-item rounded-3" href="{{ path('app_account_reservations') }}"><i class="bi bi-calendar2-check me-2"></i>Mes réservations</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item rounded-3 text-danger" href="{{ logout_path() }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Connexion</a></li>
                        <li class="nav-item"><a class="btn btn-gold btn-sm" href="{{ path('app_register') }}">Créer un compte</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
{% endblock %}

{% include '_partials/_flash.html.twig' %}

<main>
    {% block body %}{% endblock %}
</main>

{% block footer %}
    <footer class="site-footer" id="contact">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <a class="navbar-brand d-flex align-items-center gap-2 text-white fs-4 mb-3 text-decoration-none" href="{{ path('app_home') }}">
                        <span class="brand-mark"><i class="bi bi-music-note-beamed"></i></span> Symphonie
                    </a>
                    <p>Un hôtel 5 étoiles les pieds dans l'eau, où l'art de vivre méditerranéen rencontre l'hospitalité tunisienne.</p>
                    <div class="social mt-3">
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="TripAdvisor"><i class="bi bi-globe2"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>L'hôtel</h5>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a href="{{ path('app_room_index') }}">Chambres</a></li>
                        <li><a href="{{ path('app_services') }}">Spa &amp; services</a></li>
                        <li><a href="{{ path('app_cart') }}">Mon panier</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Mon espace</h5>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a href="{{ path('app_account') }}">Mon compte</a></li>
                        <li><a href="{{ path('app_account_reservations') }}">Réservations</a></li>
                        <li><a href="{{ path('app_register') }}">Inscription</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>Contact</h5>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><i class="bi bi-geo-alt text-gold me-2"></i>Avenue de la Corniche, 8050 Hammamet, Tunisie</li>
                        <li><i class="bi bi-telephone text-gold me-2"></i>+216 72 000 000</li>
                        <li><i class="bi bi-envelope text-gold me-2"></i>reservation@symphonie.tn</li>
                        <li><i class="bi bi-clock text-gold me-2"></i>Réception ouverte 24 h/24</li>
                    </ul>
                </div>
            </div>
            <div class="bottom d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>&copy; {{ 'now'|date('Y') }} {{ hotel_name }} — Projet Symfony · Développement d'applications sécurisées</span>
                <span><i class="bi bi-shield-lock text-gold me-1"></i>Protection CSRF · XSS · Injection SQL</span>
            </div>
        </div>
    </footer>
{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
    <script src="{{ asset('js/app.js') }}"></script>
{% endblock %}
</body>
</html>
