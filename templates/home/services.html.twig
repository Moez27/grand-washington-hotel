{% extends 'base.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% block title %}Services &amp; Spa{% endblock %}

{% block body %}
<header class="page-header">
    <div class="container position-relative">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li><li class="breadcrumb-item active">Services</li></ol></nav>
        <h1>Services &amp; Spa</h1>
        <p class="text-white-50 mb-0">Ajoutez ces prestations à votre séjour directement depuis la fiche d'une chambre.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <div class="row g-4">
            {% for service in services %}
                <div class="col-md-6 col-lg-4 reveal">
                    <div class="service-card">
                        <div class="media">
                            {% if service.image %}<img src="{{ asset('uploads/services/' ~ service.image) }}" alt="{{ service.name }}" loading="lazy">{% endif %}
                            <span class="icon"><i class="bi {{ service.icon }}"></i></span>
                        </div>
                        <div class="card-body">
                            <h2 class="h5">{{ service.name }}</h2>
                            <p class="text-muted-2">{{ service.description }}</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div><span class="price">{{ m.price(service.price) }}</span> <span class="small text-muted-2">{{ service.pricingLabel }}</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="empty-state"><i class="bi bi-stars"></i><p class="mt-3">Aucun service pour le moment.</p></div>
            {% endfor %}
        </div>
        <div class="text-center mt-5">
            <a href="{{ path('app_room_index') }}" class="btn btn-gold btn-lg">Choisir ma chambre</a>
        </div>
    </div>
</section>
{% endblock %}
