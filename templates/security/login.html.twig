{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Connexion{% endblock %}
{% block side_title %}Heureux de vous revoir.{% endblock %}
{% block side_text %}Retrouvez vos réservations, vos avis et préparez votre prochain séjour au bord de la Méditerranée.{% endblock %}

{% block form %}
    <a href="{{ path('app_home') }}" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Retour au site</a>
    <h1 class="h2 mt-3 mb-1">Connexion</h1>
    <p class="text-muted-2 mb-4">Accédez à votre espace client.</p>

    {% if error %}
        <div class="alert alert-danger"><i class="bi bi-exclamation-octagon me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="mb-3">
            <label for="username" class="form-label">Adresse e-mail</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Mot de passe</label>
            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        </div>
        <div class="form-check mb-4">
            <input type="checkbox" class="form-check-input" name="_remember_me" id="remember_me">
            <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
        </div>
        {# Jeton CSRF : empêche un site tiers de soumettre ce formulaire à votre place #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {% if app.request.query.get('_target_path') starts with '/' %}
            <input type="hidden" name="_target_path" value="{{ app.request.query.get('_target_path') }}">
        {% endif %}
        <button class="btn btn-navy w-100 py-3" type="submit">Se connecter</button>
    </form>
    <p class="text-center mt-4 mb-0 small">Pas encore de compte ? <a href="{{ path('app_register') }}" class="fw-semibold">Créer un compte</a></p>

    <div class="alert alert-light border small mt-4 mb-0">
        <strong>Comptes de démonstration</strong><br>
        Admin : admin@symphonie.tn / Admin123!<br>
        Client : client@symphonie.tn / Client123!
    </div>
{% endblock %}
