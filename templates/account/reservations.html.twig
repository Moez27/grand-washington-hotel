{% extends 'account/_layout.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block account_content %}
<div class="panel">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h2 class="h5 mb-0">Mes réservations <span class="text-muted-2 fw-normal">({{ reservations.totalItemCount }})</span></h2>
        <div class="d-flex flex-wrap gap-1">
            <a href="{{ path('app_account_reservations') }}" class="btn btn-sm {{ status is null ? 'btn-navy' : 'btn-light' }}">Toutes</a>
            {% for key, label in constant('App\\Entity\\Reservation::STATUSES') %}
                <a href="{{ path('app_account_reservations', {statut: key}) }}" class="btn btn-sm {{ status == key ? 'btn-navy' : 'btn-light' }}">{{ label }}</a>
            {% endfor %}
        </div>
    </div>
    {% for r in reservations %}
        {% include 'account/_resa_card.html.twig' %}
    {% else %}
        <div class="empty-state">
            <i class="bi bi-calendar2-x"></i>
            <p class="mt-2 text-muted-2">Aucune réservation.</p>
            <a href="{{ path('app_room_index') }}" class="btn btn-gold btn-sm">Réserver une chambre</a>
        </div>
    {% endfor %}
    <div class="d-flex justify-content-center mt-3">{{ knp_pagination_render(reservations) }}</div>
</div>
{% endblock %}
