{% extends 'account/_layout.html.twig' %}

{% block title %}Profil &amp; sécurité{% endblock %}

{% block account_content %}
<div class="panel mb-4">
    <h2 class="h5 mb-3"><i class="bi bi-person text-gold me-2"></i>Informations personnelles</h2>
    {{ form_start(profile, {attr: {novalidate: 'novalidate'}}) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(profile.firstName) }}</div>
            <div class="col-md-6">{{ form_row(profile.lastName) }}</div>
            <div class="col-md-6">{{ form_row(profile.email) }}</div>
            <div class="col-md-6">{{ form_row(profile.phone) }}</div>
        </div>
        <button class="btn btn-gold">Enregistrer</button>
    {{ form_end(profile) }}
</div>

<div class="panel">
    <h2 class="h5 mb-3"><i class="bi bi-shield-lock text-gold me-2"></i>Changer de mot de passe</h2>
    {{ form_start(password, {attr: {novalidate: 'novalidate'}}) }}
        <div class="row g-3">
            <div class="col-md-12">{{ form_row(password.currentPassword) }}</div>
            <div class="col-md-6">{{ form_row(password.plainPassword.first) }}</div>
            <div class="col-md-6">{{ form_row(password.plainPassword.second) }}</div>
        </div>
        {{ form_errors(password.plainPassword) }}
        <button class="btn btn-navy">Mettre à jour le mot de passe</button>
    {{ form_end(password) }}
</div>
{% endblock %}
