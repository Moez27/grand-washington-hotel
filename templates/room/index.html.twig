{% extends 'base.html.twig' %}

{% block title %}Chambres &amp; Suites{% endblock %}

{% block body %}
<header class="page-header">
    <div class="container position-relative">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li><li class="breadcrumb-item active">Chambres</li></ol></nav>
        <h1>Chambres &amp; Suites</h1>
        <p class="text-white-50 mb-0">{{ rooms.totalItemCount }} hébergement{{ rooms.totalItemCount > 1 ? 's' }} correspond{{ rooms.totalItemCount > 1 ? 'ent' }} à votre recherche{% if datesApplied %} et {{ rooms.totalItemCount > 1 ? 'sont disponibles' : 'est disponible' }} sur vos dates{% endif %}.</p>
    </div>
</header>

<section class="section-sm bg-sand">
    <div class="container">
        <div class="row g-4">
            <aside class="col-lg-3">
                <div class="filter-card">
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 mb-0"><i class="bi bi-sliders text-gold me-2"></i>Filtres</h2>
                            {% if filtered %}<a href="{{ path('app_room_index') }}" class="small">Réinitialiser</a>{% endif %}
                        </div>
                        {{ form_row(form.q) }}
                        <h6 class="mt-3">Vos dates</h6>
                        <div class="row g-2">
                            <div class="col-6 col-lg-12">{{ form_row(form.checkIn) }}</div>
                            <div class="col-6 col-lg-12">{{ form_row(form.checkOut) }}</div>
                        </div>
                        {{ form_row(form.guests) }}
                        {{ form_row(form.category) }}
                        <h6 class="mt-3">Budget / nuit (DT)</h6>
                        <div class="row g-2">
                            <div class="col-6">{{ form_widget(form.minPrice, {attr: {placeholder: priceRange.min|round}}) }}</div>
                            <div class="col-6">{{ form_widget(form.maxPrice, {attr: {placeholder: priceRange.max|round}}) }}</div>
                            <div class="col-12">{{ form_errors(form.minPrice) }}{{ form_errors(form.maxPrice) }}</div>
                        </div>
                        <h6 class="mt-4">Équipements</h6>
                        {% for child in form.amenities %}{{ form_widget(child) }}{% endfor %}
                        <div class="mt-3">{{ form_row(form.sort) }}</div>
                        <button class="btn btn-navy w-100 mt-2"><i class="bi bi-search me-2"></i>Appliquer</button>
                    {{ form_end(form, {render_rest: false}) }}
                </div>
            </aside>

            <div class="col-lg-9">
                <div class="row g-4">
                    {% for room in rooms %}
                        {% set link_params = datesApplied ? {checkIn: app.request.query.get('checkIn'), checkOut: app.request.query.get('checkOut'), guests: app.request.query.get('guests')} : {} %}
                        <div class="col-md-6 col-xl-4 reveal">{% include '_partials/_room_card.html.twig' %}</div>
                    {% else %}
                        <div class="col-12">
                            <div class="panel empty-state">
                                <i class="bi bi-calendar-x"></i>
                                <h2 class="h4 mt-3">Aucune chambre ne correspond</h2>
                                <p class="text-muted-2">Essayez d'autres dates ou élargissez vos critères.</p>
                                <a href="{{ path('app_room_index') }}" class="btn btn-gold">Voir toutes les chambres</a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="d-flex justify-content-center mt-5">{{ knp_pagination_render(rooms) }}</div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
