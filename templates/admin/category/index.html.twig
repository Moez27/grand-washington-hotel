{% extends 'admin/base.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% block title %}Catégories{% endblock %}

{% block body %}
{% include 'admin/_page_header.html.twig' with {title: 'Catégories de chambres', subtitle: categories|length ~ ' catégorie(s)', new_path: path('admin_category_new'), new_label: 'Nouvelle catégorie'} %}
<div class="row g-3">
    {% for row in categories %}
        {% set c = row[0] %}
        <div class="col-md-6 col-xl-4">
            <div class="card-x h-100">
                <div class="card-x-body d-flex gap-3">
                    <span class="icon-preview flex-shrink-0"><i class="bi {{ c.icon }}"></i></span>
                    <div class="flex-grow-1">
                        <h2 class="h6 mb-1" style="font-family:Inter">{{ c.name }}</h2>
                        <p class="small text-muted mb-2">{{ c.description|u.truncate(110, '…') }}</p>
                        <div class="small"><strong>{{ row.roomCount }}</strong> chambre(s){% if row.minPrice %} · dès {{ m.price(row.minPrice) }}{% endif %}</div>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <a href="{{ path('admin_category_edit', {id: c.id}) }}" class="btn btn-light btn-icon" title="Modifier"><i class="bi bi-pencil"></i></a>
                        {% include 'admin/_delete_form.html.twig' with {action: path('admin_category_delete', {id: c.id}), id: c.id} %}
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
