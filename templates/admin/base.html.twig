<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Tableau de bord{% endblock %} · Admin Symphonie</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2216%22 fill=%22%230e1c2b%22/><text x=%2232%22 y=%2244%22 font-size=%2234%22 text-anchor=%22middle%22 font-family=%22Georgia%22 fill=%22%23c8a165%22>S</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/admin.css') }}" rel="stylesheet">
</head>
<body>
{% set route = app.request.attributes.get('_route') %}
{% set pending = admin_pending_count() %}
{% set pendingReviews = admin_pending_reviews() %}
<aside class="sidebar">
    <a class="brand" href="{{ path('admin_dashboard') }}">
        <span class="brand-mark"><i class="bi bi-music-note-beamed"></i></span>
        <span>Symphonie<small>Back-office</small></span>
    </a>
    <nav class="nav flex-column">
        <a class="nav-link {{ route == 'admin_dashboard' ? 'active' }}" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2"></i>Tableau de bord</a>

        <div class="nav-section">Activité</div>
        <a class="nav-link {{ route starts with 'admin_reservation' ? 'active' }}" href="{{ path('admin_reservation_index') }}"><i class="bi bi-calendar2-check"></i>Réservations {% if pending %}<span class="badge rounded-pill text-bg-warning">{{ pending }}</span>{% endif %}</a>
        <a class="nav-link {{ route starts with 'admin_user' ? 'active' }}" href="{{ path('admin_user_index') }}"><i class="bi bi-people"></i>Clients</a>
        <a class="nav-link {{ route starts with 'admin_review' ? 'active' }}" href="{{ path('admin_review_index') }}"><i class="bi bi-chat-square-heart"></i>Avis {% if pendingReviews %}<span class="badge rounded-pill text-bg-light">{{ pendingReviews }}</span>{% endif %}</a>

        <div class="nav-section">Catalogue</div>
        <a class="nav-link {{ route starts with 'admin_room' ? 'active' }}" href="{{ path('admin_room_index') }}"><i class="bi bi-door-open"></i>Chambres</a>
        <a class="nav-link {{ route starts with 'admin_category' ? 'active' }}" href="{{ path('admin_category_index') }}"><i class="bi bi-tags"></i>Catégories</a>
        <a class="nav-link {{ route starts with 'admin_amenity' ? 'active' }}" href="{{ path('admin_amenity_index') }}"><i class="bi bi-wifi"></i>Équipements</a>
        <a class="nav-link {{ route starts with 'admin_service' ? 'active' }}" href="{{ path('admin_service_index') }}"><i class="bi bi-stars"></i>Services &amp; Spa</a>

        <div class="nav-section">Site</div>
        <a class="nav-link" href="{{ path('app_home') }}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i>Voir le site</a>
        <a class="nav-link" href="{{ logout_path() }}"><i class="bi bi-power"></i>Déconnexion</a>
    </nav>
</aside>
<div class="sidebar-backdrop"></div>

<div class="main">
    <header class="topbar">
        <button class="btn btn-light btn-icon d-lg-none" data-toggle-sidebar aria-label="Menu"><i class="bi bi-list"></i></button>
        <form class="d-none d-md-block flex-grow-1" style="max-width:420px" action="{{ path('admin_reservation_index') }}" method="get">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="search" name="q" class="form-control border-start-0" placeholder="Référence, client, chambre…" maxlength="60">
            </div>
        </form>
        <div class="ms-auto d-flex align-items-center gap-3">
            <a href="{{ path('admin_reservation_index', {status: 'pending'}) }}" class="btn btn-light btn-icon position-relative" aria-label="Réservations en attente">
                <i class="bi bi-bell"></i>
                {% if pending %}<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">{{ pending }}</span>{% endif %}
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="avatar">{{ app.user.initials }}</span>
                <div class="d-none d-sm-block lh-sm"><div class="fw-semibold small">{{ app.user.fullName }}</div><div class="text-muted" style="font-size:.75rem">Administrateur</div></div>
            </div>
        </div>
    </header>

    {% include '_partials/_flash.html.twig' %}

    <main class="content">
        {% block body %}{% endblock %}
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
<script src="{{ asset('js/admin.js') }}"></script>
</body>
</html>
