{% extends 'admin/base.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% block body %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Bonjour {{ app.user.firstName }} 👋</h1>
        <div class="page-sub">Voici l'activité de l'hôtel au {{ 'now'|format_date('full', locale: 'fr') }}.</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_reservation_export') }}" class="btn btn-light"><i class="bi bi-download me-1"></i>Export CSV</a>
        <a href="{{ path('admin_reservation_new') }}" class="btn btn-gold"><i class="bi bi-plus-lg me-1"></i>Nouvelle réservation</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-x kpi">
            <div class="icon ic-gold"><i class="bi bi-cash-coin"></i></div>
            <div>
                <div class="label">CA du mois</div>
                <div class="value">{{ m.price(stats.kpi.revenueThisMonth) }}</div>
                {% if stats.kpi.revenueTrend is not null %}
                    <div class="trend {{ stats.kpi.revenueTrend >= 0 ? 'text-success' : 'text-danger' }}"><i class="bi bi-arrow-{{ stats.kpi.revenueTrend >= 0 ? 'up' : 'down' }}-right"></i> {{ stats.kpi.revenueTrend }}% vs mois dernier</div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-x kpi">
            <div class="icon ic-blue"><i class="bi bi-calendar2-check"></i></div>
            <div>
                <div class="label">Réservations</div>
                <div class="value">{{ stats.kpi.bookings }}</div>
                <div class="trend text-warning"><i class="bi bi-hourglass-split"></i> {{ stats.kpi.pending }} en attente</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-x kpi">
            <div class="icon ic-green"><i class="bi bi-house-check"></i></div>
            <div>
                <div class="label">Taux d'occupation (mois)</div>
                <div class="value">{{ stats.kpi.occupancy }}%</div>
                <div class="progress mt-2" style="height:6px;width:140px"><div class="progress-bar bg-success" style="width: {{ stats.kpi.occupancy }}%"></div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-x kpi">
            <div class="icon ic-purple"><i class="bi bi-people"></i></div>
            <div>
                <div class="label">Clients inscrits</div>
                <div class="value">{{ stats.kpi.clients }}</div>
                <div class="trend text-muted">Panier moyen {{ m.price(stats.kpi.averageBasket) }}</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <div class="card-x h-100">
            <div class="card-x-header"><h2>Chiffre d'affaires &amp; réservations — 12 mois</h2><span class="small text-muted">Total {{ m.price(stats.kpi.revenueTotal) }}</span></div>
            <div class="card-x-body"><div class="chart-box"><canvas id="chart-revenue"></canvas></div></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card-x h-100">
            <div class="card-x-header"><h2>Statut des réservations</h2></div>
            <div class="card-x-body"><div class="chart-box"><canvas id="chart-status"></canvas></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card-x h-100">
            <div class="card-x-header"><h2>CA par catégorie</h2></div>
            <div class="card-x-body"><div class="chart-box-sm"><canvas id="chart-category"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-x h-100">
            <div class="card-x-header"><h2>Chambres les plus réservées</h2></div>
            <div class="card-x-body"><div class="chart-box-sm"><canvas id="chart-rooms"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-x h-100">
            <div class="card-x-header"><h2>Nouveaux clients</h2></div>
            <div class="card-x-body"><div class="chart-box-sm"><canvas id="chart-signups"></canvas></div></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card-x">
            <div class="card-x-header"><h2>Dernières réservations</h2><a href="{{ path('admin_reservation_index') }}" class="small">Tout voir</a></div>
            <div class="table-responsive">
                <table class="table table-x">
                    <thead><tr><th>Référence</th><th>Client</th><th>Chambre</th><th>Séjour</th><th>Montant</th><th>Statut</th></tr></thead>
                    <tbody>
                    {% for r in latest %}
                        <tr>
                            <td><a href="{{ path('admin_reservation_show', {id: r.id}) }}" class="fw-semibold">{{ r.reference }}</a></td>
                            <td>{{ r.user.fullName }}</td>
                            <td>{{ r.room.name }}</td>
                            <td class="text-nowrap">{{ r.checkIn|date('d/m') }} → {{ r.checkOut|date('d/m/y') }}</td>
                            <td class="fw-semibold text-nowrap">{{ m.price(r.totalPrice) }}</td>
                            <td>{{ m.status(r) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card-x mb-3">
            <div class="card-x-header"><h2>Arrivées des 7 prochains jours</h2></div>
            <div class="card-x-body py-1">
                <ul class="list-x">
                    {% for r in arrivals %}
                        <li>
                            <div class="text-center" style="width:44px"><div class="fw-bold">{{ r.checkIn|date('d') }}</div><div class="small text-muted text-uppercase">{{ r.checkIn|format_date(pattern: 'MMM', locale: 'fr') }}</div></div>
                            <div class="flex-grow-1"><div class="fw-semibold small">{{ r.user.fullName }}</div><div class="small text-muted">{{ r.room.name }} · {{ r.nights }} nuit(s)</div></div>
                            {{ m.status(r) }}
                        </li>
                    {% else %}
                        <li class="text-muted small">Aucune arrivée prévue.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="card-x">
            <div class="card-x-header"><h2>Derniers inscrits</h2><a href="{{ path('admin_user_index') }}" class="small">Clients</a></div>
            <div class="card-x-body py-1">
                <ul class="list-x">
                    {% for u in newClients %}
                        <li><span class="avatar" style="width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--gold-soft);color:var(--gold-2);font-weight:700;font-size:.8rem">{{ u.initials }}</span>
                            <div class="flex-grow-1"><a href="{{ path('admin_user_show', {id: u.id}) }}" class="fw-semibold small text-reset">{{ u.fullName }}</a><div class="small text-muted">{{ u.email }}</div></div>
                            <span class="small text-muted">{{ u.createdAt|date('d/m') }}</span></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>

{# Données des graphiques : bloc JSON non exécutable (compatible CSP), échappé contre l'injection de balises #}
<script type="application/json" id="dashboard-data">{{ stats.charts|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
{% endblock %}
