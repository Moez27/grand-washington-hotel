{% extends 'admin/base.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% block title %}Réservations{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div><h1 class="page-title">Réservations</h1><div class="page-sub">{{ reservations.totalItemCount }} résultat(s)</div></div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_reservation_export', filters|filter(v => v)) }}" class="btn btn-light"><i class="bi bi-filetype-csv me-1"></i>Exporter</a>
        <a href="{{ path('admin_reservation_new') }}" class="btn btn-gold"><i class="bi bi-plus-lg me-1"></i>Nouvelle réservation</a>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a href="{{ path('admin_reservation_index') }}" class="btn btn-sm {{ filters.status is null ? 'btn-dark' : 'btn-light' }}">Toutes <span class="opacity-75">{{ counts|reduce((a, b) => a + b, 0) }}</span></a>
    {% for key, label in constant('App\\Entity\\Reservation::STATUSES') %}
        <a href="{{ path('admin_reservation_index', {status: key}) }}" class="btn btn-sm {{ filters.status == key ? 'btn-dark' : 'btn-light' }}">{{ label }} <span class="opacity-75">{{ counts[key] }}</span></a>
    {% endfor %}
</div>

<div class="card-x">
    <div class="card-x-header">
        <form class="row g-2 filters flex-grow-1" method="get">
            {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}
            <div class="col-md-4"><input type="search" name="q" value="{{ filters.q }}" class="form-control" placeholder="Référence, client, e-mail, chambre…" maxlength="60"></div>
            <div class="col-6 col-md-3"><div class="input-group"><span class="input-group-text small">Du</span><input type="date" name="from" value="{{ filters.from }}" class="form-control"></div></div>
            <div class="col-6 col-md-3"><div class="input-group"><span class="input-group-text small">Au</span><input type="date" name="to" value="{{ filters.to }}" class="form-control"></div></div>
            <div class="col-md-2 d-flex gap-2"><button class="btn btn-dark flex-grow-1"><i class="bi bi-funnel"></i></button>{% if filters|filter(v => v) %}<a href="{{ path('admin_reservation_index') }}" class="btn btn-light"><i class="bi bi-x-lg"></i></a>{% endif %}</div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-x">
            <thead><tr><th>Référence</th><th>Client</th><th>Chambre</th><th>{{ knp_pagination_sortable(reservations, 'Arrivée', 'r.checkIn') }}</th><th>Nuits</th><th>{{ knp_pagination_sortable(reservations, 'Montant', 'r.totalPrice') }}</th><th>Statut</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            {% for r in reservations %}
                <tr>
                    <td><a href="{{ path('admin_reservation_show', {id: r.id}) }}" class="fw-semibold">{{ r.reference }}</a><div class="small text-muted">{{ r.createdAt|date('d/m/y H:i') }}</div></td>
                    <td><a href="{{ path('admin_user_show', {id: r.user.id}) }}" class="text-reset">{{ r.user.fullName }}</a><div class="small text-muted">{{ r.user.email }}</div></td>
                    <td>{{ r.room.name }}</td>
                    <td class="text-nowrap">{{ r.checkIn|date('d/m/Y') }}</td>
                    <td>{{ r.nights }}</td>
                    <td class="fw-semibold text-nowrap">{{ m.price(r.totalPrice) }}</td>
                    <td>
                        <form method="post" action="{{ path('admin_reservation_status', {id: r.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('status' ~ r.id) }}">
                            <select name="status" class="form-select form-select-sm status-badge status-{{ r.status }} border-0" data-autosubmit aria-label="Statut">
                                {% for key, label in constant('App\\Entity\\Reservation::STATUSES') %}<option value="{{ key }}" {{ r.status == key ? 'selected' }}>{{ label }}</option>{% endfor %}
                            </select>
                        </form>
                    </td>
                    <td class="text-end text-nowrap">
                        <a href="{{ path('admin_reservation_edit', {id: r.id}) }}" class="btn btn-light btn-icon"><i class="bi bi-pencil"></i></a>
                        {% include 'admin/_delete_form.html.twig' with {action: path('admin_reservation_delete', {id: r.id}), id: r.id, message: 'Supprimer définitivement la réservation ' ~ r.reference ~ ' ?'} %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-center text-muted py-5">Aucune réservation.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="p-3 d-flex justify-content-center">{{ knp_pagination_render(reservations) }}</div>
</div>
{% endblock %}
