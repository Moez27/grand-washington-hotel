{% extends 'admin/base.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% block title %}Clients{% endblock %}

{% block body %}
{% include 'admin/_page_header.html.twig' with {title: 'Clients & utilisateurs', subtitle: users.totalItemCount ~ ' compte(s)', new_path: path('admin_user_new'), new_label: 'Nouvel utilisateur'} %}
<div class="card-x">
    <div class="card-x-header">
        <form class="row g-2 filters flex-grow-1" method="get">
            <div class="col-md-5"><input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Nom, e-mail, téléphone…" maxlength="60"></div>
            <div class="col-6 col-md-2"><select name="role" class="form-select"><option value="">Tous les rôles</option><option value="client" {{ role == 'client' ? 'selected' }}>Clients</option><option value="admin" {{ role == 'admin' ? 'selected' }}>Admins</option></select></div>
            <div class="col-6 col-md-3"><select name="etat" class="form-select"><option value="">Tous les états</option><option value="active" {{ state == 'active' ? 'selected' }}>Actifs</option><option value="blocked" {{ state == 'blocked' ? 'selected' }}>Suspendus</option></select></div>
            <div class="col-md-2 d-flex gap-2"><button class="btn btn-dark flex-grow-1"><i class="bi bi-funnel"></i></button>{% if q or role or state %}<a href="{{ path('admin_user_index') }}" class="btn btn-light"><i class="bi bi-x-lg"></i></a>{% endif %}</div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-x">
            <thead><tr><th>{{ knp_pagination_sortable(users, 'Nom', 'u.lastName') }}</th><th>Contact</th><th>Rôle</th><th>Réservations</th><th>{{ knp_pagination_sortable(users, 'Inscription', 'u.createdAt') }}</th><th>État</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            {% for u in users %}
                <tr>
                    <td><a href="{{ path('admin_user_show', {id: u.id}) }}" class="fw-semibold text-reset">{{ u.fullName }}</a></td>
                    <td><div class="small">{{ u.email }}</div><div class="small text-muted">{{ u.phone ?: '—' }}</div></td>
                    <td>{% if u.admin %}<span class="badge text-bg-dark">Admin</span>{% else %}<span class="badge text-bg-light border">Client</span>{% endif %}</td>
                    <td>{{ u.reservations|length }}</td>
                    <td class="small">{{ u.createdAt|date('d/m/Y') }}</td>
                    <td>{% if u.blocked %}<span class="badge rounded-pill text-bg-danger">Suspendu</span>{% else %}<span class="badge rounded-pill text-bg-success">Actif</span>{% endif %}</td>
                    <td class="text-end text-nowrap">
                        <a href="{{ path('admin_user_show', {id: u.id}) }}" class="btn btn-light btn-icon"><i class="bi bi-eye"></i></a>
                        <a href="{{ path('admin_user_edit', {id: u.id}) }}" class="btn btn-light btn-icon"><i class="bi bi-pencil"></i></a>
                        {% if u != app.user %}{% include 'admin/_delete_form.html.twig' with {action: path('admin_user_delete', {id: u.id}), id: u.id, message: 'Supprimer ce compte ainsi que ses réservations et avis ?'} %}{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="p-3 d-flex justify-content-center">{{ knp_pagination_render(users) }}</div>
</div>
{% endblock %}
