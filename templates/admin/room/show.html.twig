{% extends 'admin/base.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% block title %}{{ room.name }}{% endblock %}

{% block body %}
<a href="{{ path('admin_room_index') }}" class="small text-decoration-none d-inline-block mb-2"><i class="bi bi-arrow-left"></i> Chambres</a>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title">{{ room.name }}</h1>
        <div class="page-sub"><i class="bi {{ room.category.icon }} me-1"></i>{{ room.category.name }} · créée le {{ room.createdAt|date('d/m/Y') }}{% if room.updatedAt %} · modifiée le {{ room.updatedAt|date('d/m/Y H:i') }}{% endif %}</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_room_show', {slug: room.slug}) }}" target="_blank" class="btn btn-light"><i class="bi bi-eye me-1"></i>Voir sur le site</a>
        <a href="{{ path('admin_room_edit', {id: room.id}) }}" class="btn btn-gold"><i class="bi bi-pencil me-1"></i>Modifier</a>
        {% include 'admin/_delete_form.html.twig' with {action: path('admin_room_delete', {id: room.id}), id: room.id, big: true} %}
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-5">
        <div class="card-x">
            <div class="card-x-body">
                {% if room.image %}<img src="{{ asset('uploads/rooms/' ~ room.image) }}" class="thumb-lg mb-3" alt="{{ room.name }}">{% endif %}
                <div class="row g-2 text-center">
                    <div class="col-3"><div class="fw-bold">{{ m.price(room.pricePerNight) }}</div><div class="small text-muted">/ nuit</div></div>
                    <div class="col-3"><div class="fw-bold">{{ room.capacity }}</div><div class="small text-muted">pers.</div></div>
                    <div class="col-3"><div class="fw-bold">{{ room.size }} m²</div><div class="small text-muted">surface</div></div>
                    <div class="col-3"><div class="fw-bold">{{ room.averageRating ?? '—' }}</div><div class="small text-muted">note</div></div>
                </div>
                <hr>
                <p class="small text-muted mb-1">Accroche</p>
                <p>{{ room.shortDescription }}</p>
                <p class="small text-muted mb-1">Description</p>
                <p class="small">{{ room.description|nl2br }}</p>
                <p class="small text-muted mb-1">Équipements</p>
                {% for a in room.amenities %}<span class="badge text-bg-light border me-1 mb-1"><i class="bi {{ a.icon }} me-1"></i>{{ a.name }}</span>{% endfor %}
                <div class="mt-3">
                    <span class="badge rounded-pill {{ room.active ? 'text-bg-success' : 'text-bg-secondary' }}">{{ room.active ? 'En ligne' : 'Masquée' }}</span>
                    {% if room.featured %}<span class="badge rounded-pill text-bg-warning">Mise en avant</span>{% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="card-x">
            <div class="card-x-header"><h2>Réservations de cette chambre ({{ room.reservations|length }})</h2></div>
            <div class="table-responsive" style="max-height:640px">
                <table class="table table-x">
                    <thead><tr><th>Réf.</th><th>Client</th><th>Séjour</th><th>Montant</th><th>Statut</th></tr></thead>
                    <tbody>
                    {% for r in room.reservations|sort((a, b) => b.checkIn <=> a.checkIn) %}
                        <tr>
                            <td><a href="{{ path('admin_reservation_show', {id: r.id}) }}">{{ r.reference }}</a></td>
                            <td>{{ r.user.fullName }}</td>
                            <td class="text-nowrap">{{ r.checkIn|date('d/m/y') }} → {{ r.checkOut|date('d/m/y') }}</td>
                            <td>{{ m.price(r.totalPrice) }}</td>
                            <td>{{ m.status(r) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">Aucune réservation.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
