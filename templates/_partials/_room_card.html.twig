{% import '_partials/_macros.html.twig' as m %}
<article class="room-card card position-relative">
    <div class="media">
        {{ m.room_image(room, '') }}
        <span class="badge-cat"><i class="bi {{ room.category.icon }} me-1"></i>{{ room.category.name }}</span>
        {% if room.featured %}<span class="badge-featured"><i class="bi bi-award me-1"></i>Coup de cœur</span>{% endif %}
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h3><a href="{{ path('app_room_show', {slug: room.slug}|merge(link_params ?? {})) }}">{{ room.name }}</a></h3>
            {% if room.averageRating %}
                <span class="small fw-semibold text-nowrap"><i class="bi bi-star-fill text-warning"></i> {{ room.averageRating }}</span>
            {% endif %}
        </div>
        <div class="meta mb-3">
            <span><i class="bi bi-people me-1"></i>{{ room.capacity }} pers.</span>
            <span><i class="bi bi-arrows-angle-expand me-1"></i>{{ room.size }} m²</span>
            <span><i class="bi bi-moon-stars me-1"></i>{{ room.bedType|u.truncate(22, '…') }}</span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <div class="price">{{ m.price(room.pricePerNight) }} <small>/ nuit</small></div>
            <span class="btn btn-outline-gold btn-sm">Découvrir <i class="bi bi-arrow-right"></i></span>
        </div>
    </div>
</article>
